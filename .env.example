NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Default: endpoints "ready" in docs/API_CONTRATO.md use the real API; "planned" ones use demo data.
# Set to "false" to send everything to the real API.
NEXT_PUBLIC_USE_MOCKS=planned
